package SysMLVerificationPlans; 

verification plan verifySchedualability {
	component
		s: SysMLSystemTest::test.i;
	domains
		SysMLContracts::sysmldomain; 
	claims
		`And([Deadlines[i] >= Responses[i] for i in range(len(Deadlines))])`;
		`And([Latency[i] <= MaxLatency[i] for i in range(len(Latency))])`;
	contracts
		SysMLContracts::SysMLSchedulabilityContract;
		SysMLContracts::SysMLEndToEndDelayContract;
}
