package SysMLContracts;

contract implementation SysMLTestImplementation {`
import math

def addError(error,msg):
	error[0]+="|"+msg

def areTasksHarmonicBoundSchedulable(tasks,error0):
	util = 0.0
	counted = set()
	for i in range(len(tasks)):
		e2eflow = tasks[i]
		j=0
		nodeType = True
		while j< len(e2eflow):
			if nodeType:
				node = e2eflow[j]
				id = node[0]
				period = node[2]
				deadline = node[3]
				wcet = node[4]
				if not id in counted:
					counted.add(id)
					#print(f"name({node[1]}) period({period}) wcet({wcet})")
					util = util + float(wcet)/ float(period) 
				nodeType = False
			else:
				nodeType = True
				msg = e2eflow[j]							
			j = j +1
	#print(f"Utilization: {util}")
	if util <= 1.0:
		addError(info0,"{} tasks are schedulable")
	else:
		addError(error0,"{} tasks are not schedulable")
	return util <= 1.0

# testvar = [[[0,comSensors],[1,GroundDetected],[2,com,100],[3,setTurnRate],[4,AeleronActuator]]]
def testSysMLVariable(testvar, error0):
	for i in range(len(testvar)):
		e2eflow = testvar[i]
		print("e2eflow: ",e2eflow)
		j=0
		nodeType = True
		while j< len(e2eflow):
			if nodeType:
				srcNode = e2eflow[j]
				nodeType = False
				#print(f"Node(id({srcNode[0]}),name({srcNode[1]}),params:{srcNode[2:]})")
			else:
				nodeType = True
				msg = e2eflow[j]							
				print(f"msg(id({msg[0]}) name({msg[1]}))")
			j = j +1
	#print("sysval: ",testvar)
	return True
	
def areEndToEndLatenciesLessThanMax(tasks,error0):
	counted = set()
	for i in range(len(tasks)):
		e2eflow = tasks[i]
		j=0
		nodeType = True
		maxLatency = 0
		latency = 0
		while j< len(e2eflow):
			if nodeType:
				node = e2eflow[j]
				id = node[0]
				period = node[2]
				deadline = node[3]
				wcet = node[4]
				if len(node)>5:
					maxLatency = node[5]
				latency += wcet				
				nodeType = False
			else:
				nodeType = True
				msg = e2eflow[j]							
			j = j +1
		if latency > maxLatency:
			addError(error0,"{} latency greater than max latecy")
			return False
		else:
			addError(info0,"{} latency less than max latency")
	#print(f"Utilization: {util}")
	return True
	 
`}

domain sysmldomain {
	queries
		sysmlval model = 'loadModel(C:/SEI/Tools/cameo/temp/MQLTest1.uml)';
		sysmlval sequence = 'loadDiagram(model,SelfCheckingPair1Sequence)';
		sysmlval e2eflows = 'end2endFlows(sequence,name,period,deadline,wcet)';
		sysmlval e2eflows1 = 'end2endFlows(sequence,name,period,deadline,wcet,maxendtoendlatency)';
	declarations
		'''
		Deadlines = IntVector('deadline', 1)
		Responses = IntVector('response', 1)
		Latency = IntVector('latency',1)
		MaxLatency = IntVector('maxlatency',1)	
		'''
}

contract SysMLSchedulabilityContract {
	domains
		sysmldomain;
	assumptions
	guarantee
		<=> `And([Deadlines[i] >= Responses[i] for i in range(len(Deadlines))])`;

	analysis
		'''areTasksHarmonicBoundSchedulable(${e2eflows$})'''; 
}

contract SysMLEndToEndDelayContract {
	domains
		sysmldomain;
	assumptions
	guarantee
		<=> `And([Latency[i] <= MaxLatency[i] for i in range(len(Latency))])`;
	analysis
		'''areEndToEndLatenciesLessThanMax(${e2eflows1$})''';
}

